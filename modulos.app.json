        "ac_espacios",
        "ac_videos",
        "ac_video_accesos"
      ],
      "mcp": {
        "guia": "Fallas (ausente o con excusa) y su reposición: agendada en un espacio con cupos, virtual con clase grabada, o hecha. Consulta lo pendiente con reposiciones_pendientes. Una reposición virtual se completa cuando el estudiante ve el 90 % de la clase grabada con su enlace personal.",
        "ejemplos": [
          "Pídele: «¿Qué reposiciones están pendientes por agendar?»"
        ],
        "flujos": [
          {
            "id": "pendientes",
            "nombre": "Reposiciones pendientes",
            "descripcion": "Ver las fallas sin reponer y proponer cómo cerrarlas.",
            "pasos": [
              "reposiciones.pendientes"
            ]
          }
        ]
      }
