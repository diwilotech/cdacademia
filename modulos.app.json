      ]
    },
    {
      "id": "cuotas",
      "nombre": "Cuotas",
      "icono": "bi-calendar-check",
      "menu": {
        "ruta": "/staff/cuotas.html",
        "orden": 40,
        "oculto": true
      },
      "permisos": {
        "ver": "admin",
        "configurar": "admin"
      },
      "widgets": [
        {
          "id": "vencidas",
          "api": "/api/cuotas/resumen"
        }
      ],
      "depende_de": [
        "matriculas"
      ],
      "tipo": "propio",
      "tablas": [
        "ac_cuotas",
        "ac_pagos"
      ],
      "mcp": {
        "guia": "Cartera y pagos de las matrículas. Consulta la cartera con cuotas_cartera (por estado: vencida, hoy, pendiente) antes de hablar de deudas. Registrar un pago es una escritura con efectos contables (genera recibo y asiento en Finanzas): confírmalo con la persona y verifica el valor y el medio.",
        "ejemplos": [
          "Pídele: «¿Quién tiene cuotas vencidas esta semana?»",
          "Pídele: «Registra un pago de 150.000 por Nequi de la matrícula 12»"
        ],
        "flujos": [
          {
            "id": "cobranza",
            "nombre": "Cobranza de la semana",
            "descripcion": "Listar la cartera vencida y proponer a quién escribir.",
            "pasos": [
              "cuotas.cartera"
            ],
            "prompt": "Revisa la cartera de la academia (cuotas vencidas y que vencen hoy), ordénala por antigüedad y propón a quién escribirle primero con un mensaje corto en el tono de la marca. No registres pagos sin mi confirmación."
          }
        ]
      }
    },
    {
      "id": "reposiciones",
      "nombre": "Reposiciones",
      "icono": "bi-arrow-repeat",
      "menu": {
        "ruta": "/staff/reposiciones.html",
