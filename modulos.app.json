{
  "app": "cdacademia",
  "nombre": "CD Academia",
  "tema": "rosa",
  "centrales": [
    "finanzas",
    "marketing",
    "marca",
    "ai"
  ],
  "modulos": [
    {
      "id": "cursos",
      "nombre": "Cursos",
      "icono": "bi-mortarboard",
      "menu": {
        "ruta": "/staff/cursos.html",
        "orden": 10
      },
      "permisos": {
        "ver": "staff",
        "configurar": "admin"
      },
      "widgets": [
        {
          "id": "hoy",
          "api": "/api/cursos/resumen"
        }
      ],
      "depende_de": [],
      "tipo": "propio",
      "tablas": [
        "ac_cursos",
        "ac_clases",
        "ac_evaluaciones",
        "ac_cupones",
        "ac_asistencia",
        "ac_notas"
      ],
      "mcp": {
        "guia": "Cursos con sus clases, asistencia y notas. Para saber qué hay hoy usa cursos_clases_de_hoy. Las clases se generan del horario del curso y saltan festivos.",
        "ejemplos": [
          "Pídele: «¿Qué clases tengo hoy y con cuántos estudiantes?»"
        ],
        "flujos": [
          {
            "id": "hoy",
            "nombre": "Clases de hoy",
            "descripcion": "Ver las clases del día.",
            "pasos": [
              "cursos.clases_de_hoy"
            ]
          }
        ]
      }
    },
    {
      "id": "estudiantes",
      "nombre": "Estudiantes",
      "icono": "bi-people",
      "menu": {
        "ruta": "/staff/estudiantes.html",
        "orden": 20
      },
      "permisos": {
        "ver": "staff",
        "configurar": "admin"
      },
      "widgets": [
        {
          "id": "total",
          "api": "/api/estudiantes/resumen"
        }
      ],
      "depende_de": [],
      "tipo": "propio",
      "tablas": [
        "ac_estudiantes"
      ],
      "mcp": {
        "guia": "Directorio de estudiantes de la academia. Busca primero con estudiantes_buscar (nombre, documento o teléfono) y abre la ficha con estudiantes_ficha antes de responder sobre una persona. Crea estudiantes solo si no existen ya (busca antes para no duplicar).",
        "ejemplos": [
          "Pídele: «¿Cuál es el teléfono de Laura Pérez y en qué cursos está?»",
          "Pídele: «Crea al estudiante Pedro Ruiz, documento 123, teléfono 300…»"
        ],
        "flujos": [
          {
            "id": "ficha",
            "nombre": "Ficha de un estudiante",
            "descripcion": "Buscar a una persona y mostrar su ficha completa.",
            "pasos": [
              "estudiantes.buscar",
              "estudiantes.ficha"
            ]
          },
          {
            "id": "nuevo",
            "nombre": "Registrar un estudiante",
            "descripcion": "Verificar que no exista y crearlo.",
            "pasos": [
              "estudiantes.buscar",
              "estudiantes.crear"
            ]
          }
        ]
      }
    },
    {
      "id": "matriculas",
      "nombre": "Matrículas",
      "icono": "bi-person-plus",
      "menu": {
        "ruta": "/staff/matriculas.html",
        "orden": 30
      },
      "permisos": {
        "ver": "admin",
        "configurar": "admin"
      },
      "widgets": [],
      "depende_de": [
        "cursos",
        "estudiantes"
      ],
      "tipo": "propio",
